# Maintainer: jerichosiahaya <jericho dot siahaya at gmail dot com>

pkgname=snip-notes
_name=snip
pkgver=0.2.0
pkgrel=1
pkgdesc='Lightweight terminal note-taking app with full-text search and an MCP server for Claude'
arch=('x86_64' 'aarch64')
url='https://github.com/jerichosiahaya/snip'
license=('MIT')
depends=('glibc' 'libgcc')
makedepends=('cargo')
optdepends=('nano: editor used when $EDITOR is unset')
# keep makepkg's C LTO flags out of the bundled SQLite build that Rust links in
options=('!lto')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('95042cf6585a56f04c2f920c16c9832446711d5ecaf1c9254799d71d06610652')

prepare() {
  cd "$_name-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_name-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$_name-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --frozen
}

package() {
  cd "$_name-$pkgver"
  install -Dm755 target/release/snip "$pkgdir/usr/bin/snip"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md CHANGELOG.md -t "$pkgdir/usr/share/doc/$pkgname/"
}
